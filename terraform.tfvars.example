# =============================================================================
# terraform.tfvars  — DO NOT commit secrets to git; use a secrets manager
# =============================================================================

aws_region        = "us-east-1"
availability_zone = "us-east-1a"
subnet_id         = "subnet-xxxxxxxxxxxxxxxxx"   # replace with real subnet ID
scripts_bucket    = "your-glue-scripts-bucket"   # replace with your bucket

# Credentials — prefer injecting via environment variables or AWS Secrets Manager
db_username = "admin"
db_password = "REPLACE_ME"

# Tables to extract — leave as [] to auto-discover all tables per database
tables_to_extract = []

# 36 Aurora MySQL database/schema names
database_names = [
  "cariai_db_00",
  "cariai_db_01",
  "cariai_db_02",
  "cariai_db_03",
  "cariai_db_04",
  "cariai_db_05",
  "cariai_db_06",
  "cariai_db_07",
  "cariai_db_08",
  "cariai_db_09",
  "cariai_db_10",
  "cariai_db_11",
  "cariai_db_12",
  "cariai_db_13",
  "cariai_db_14",
  "cariai_db_15",
  "cariai_db_16",
  "cariai_db_17",
  "cariai_db_18",
  "cariai_db_19",
  "cariai_db_20",
