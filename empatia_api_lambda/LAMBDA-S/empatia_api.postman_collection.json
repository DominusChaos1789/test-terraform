{
  "info": {
    "name": "Empatia Transcripts API",
    "description": "Collection for testing the Empatia API Gateway endpoints (/details/events and /summary/events). Auth: OAuth 2.0 Client Credentials. Sends conversation transcripts and summaries, which are validated, queued in SQS, and landed in S3 under augusta-nexa-dev/empatia/transcripciones/.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://ba5xmxdwoh.execute-api.us-east-2.amazonaws.com/dev-1",
      "type": "string"
    },
    {
      "key": "token_url",
      "value": "https://auth.empatia.example.com/oauth2/token",
      "type": "string"
    },
    {
      "key": "client_id",
      "value": "REPLACE_WITH_CLIENT_ID",
      "type": "string"
    },
    {
      "key": "client_secret",
      "value": "REPLACE_WITH_CLIENT_SECRET",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Get OAuth2 Token (Client Credentials)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "if (json.access_token) {",
                  "    pm.collectionVariables.set('access_token', json.access_token);",
                  "    console.log('Saved access_token to collection variable.');",
                  "}",
                  "",
                  "pm.test('Response has access_token', function () {",
                  "    pm.expect(json).to.have.property('access_token');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials",
                  "type": "text"
                },
                {
                  "key": "client_id",
                  "value": "{{client_id}}",
                  "type": "text"
                },
                {
                  "key": "client_secret",
                  "value": "{{client_secret}}",
                  "type": "text"
                },
                {
                  "key": "scope",
                  "value": "transcripts:write",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{token_url}}",
              "host": [
                "{{token_url}}"
              ]
            },
            "description": "Run this first. Exchanges client_id/client_secret for a Bearer access_token using the OAuth2 Client Credentials flow, and automatically saves it to the {{access_token}} collection variable used by every other request in this collection."
          },
          "response": []
        }
      ]
    },
