  "definitions": {
    "BaseCallFields": {
      "type": "object",
      "required": [
        "tenant_id",
        "tipoPersona",
        "tipoIdentificacion",
        "numeroIdentificacion",
        "codigoTipificacion",
        "data"
      ],
      "properties": {
        "tenant_id": {
          "type": "string",
          "description": "Identifier of the tenant/client sending the data"
        },
        "idLlamada": {
          "type": "string",
          "description": "Unique identifier of the call/conversation"
        },
        "tipoPersona": {
          "type": "string",
          "enum": [
            "Natural",
            "Juridica"
          ],
          "description": "Type of person. Natural requires primerNombre + primerApellido; Juridica requires razonSocial."
        },
        "tipoIdentificacion": {
          "type": "string",
          "description": "Type of identification document (e.g. CC, NIT, CE)"
        },
        "numeroIdentificacion": {
          "type": "string",
          "description": "Identification document number"
        },
        "primerNombre": {
          "type": "string",
          "description": "First name. Required when tipoPersona is 'Natural'."
        },
        "primerApellido": {
          "type": "string",
          "description": "First last name. Required when tipoPersona is 'Natural'."
        },
        "razonSocial": {
          "type": "string",
          "description": "Company/legal entity name. Required when tipoPersona is 'Juridica'."
        },
        "codigoTipificacion": {
          "type": "string",
          "description": "Classification/typification code for the call"
        },
        "descripcionTipificacion": {
          "type": "string",
          "description": "Human-readable description of the typification code"
        },
        "fechaInicio": {
          "type": "string",
          "description": "Start date/time of the call (ISO 8601 recommended)"
        }
      },
      "title": "BaseCallFields"
    },
    "DetailsPayload": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/definitions/BaseCallFields"
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "$ref": "#/definitions/DetailsData"
            }
          }
        }
      ],
      "title": "DetailsPayload"
    },
    "DetailsData": {
      "type": "object",
      "required": [
        "conversacion"
      ],
      "properties": {
        "conversacion": {
          "type": "string",
          "description": "Full text of the conversation transcript"
        }
      },
      "title": "DetailsData"
    },
    "SummaryPayload": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/definitions/BaseCallFields"
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "$ref": "#/definitions/SummaryData"
            }
          }
        }
      ],
      "title": "SummaryPayload"
    },
    "SummaryData": {
      "type": "object",
      "required": [
        "motivo",
        "resumen"
      ],
      "properties": {
        "motivo": {
          "type": "string",
          "description": "Reason/motive for the call"
        },
        "resumen": {
          "type": "string",
          "description": "Summary text of the conversation"
        }
      },
      "title": "SummaryData"
    },
    "SuccessResponse": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string"
        },
        "record_id": {
          "type": "string"
        },
        "endpoint": {
          "type": "string",
          "enum": [
            "details",
            "summary"
          ]
        },
        "s3_key": {
          "type": "string"
        }
      },
      "title": "SuccessResponse"
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error": {
          "type": "string"
        }
      },
      "title": "ErrorResponse"
    }
  }
