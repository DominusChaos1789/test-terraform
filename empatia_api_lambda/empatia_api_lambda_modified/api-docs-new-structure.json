  "definitions": {
    "Empty": {
      "type": "object",
      "title": "Empty Schema"
    },
    "baseCallFields": {
      "type": "object",
      "required": [
        "tenant_id",
        "tipoPersona",
        "tipoIdentificacion",
        "numeroIdentificacion",
        "codigoTipificacion",
        "data"
      ],
      "properties": {
        "tenant_id": {
          "type": "string",
          "description": "Identifier of the tenant/client sending the data",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "idLlamada": {
          "type": "string",
          "description": "Unique identifier of the call/conversation",
          "maxLength": 128
        },
        "tipoPersona": {
          "type": "string",
          "description": "Type of person (Natural or Juridica)",
          "pattern": "^(Natural|Juridica)$"
        },
        "tipoIdentificacion": {
          "type": "string",
          "description": "Type of identification document (e.g. CC, NIT, CE)",
          "pattern": "^[A-Za-z]{1,10}$"
        },
        "numeroIdentificacion": {
          "type": "string",
          "description": "Identification document number",
          "pattern": "^[0-9]{1,20}$"
        },
        "primerNombre": {
          "type": "string",
          "description": "First name. Required when tipoPersona is Natural.",
          "pattern": "^[A-Za-zÀÈÌÒÙáéíóúñÑ ]{1,100}$"
        },
        "primerApellido": {
          "type": "string",
          "description": "First last name. Required when tipoPersona is Natural.",
          "pattern": "^[A-Za-zÀÈÌÒÙáéíóúñÑ ]{1,100}$"
        },
        "razonSocial": {
          "type": "string",
          "description": "Company name. Required when tipoPersona is Juridica.",
          "maxLength": 200
        },
        "codigoTipificacion": {
          "type": "string",
          "description": "Classification/typification code for the call",
          "pattern": "^[A-Za-z0-9_-]{1,50}$"
        },
        "descripcionTipificacion": {
          "type": "string",
          "description": "Human-readable description of the typification code",
          "maxLength": 255
        },
        "fechaInicio": {
          "type": "string",
          "description": "Start date/time of the call (ISO 8601)",
          "maxLength": 40
        }
      }
    },
    "detailsRequestModel": {
      "type": "object",
      "allOf": [
        { "$ref": "#/definitions/baseCallFields" },
        {
          "type": "object",
          "required": ["data"],
          "properties": {
            "data": {
              "type": "object",
              "required": ["conversacion"],
              "properties": {
                "conversacion": {
                  "type": "string",
                  "description": "Full text of the conversation transcript",
                  "maxLength": 250000
                }
              }
            }
          }
        }
      ]
    },
    "summaryRequestModel": {
      "type": "object",
      "allOf": [
        { "$ref": "#/definitions/baseCallFields" },
        {
          "type": "object",
          "required": ["data"],
          "properties": {
            "data": {
              "type": "object",
              "required": ["motivo", "resumen"],
              "properties": {
                "motivo": {
                  "type": "string",
                  "description": "Reason/motive for the call",
                  "maxLength": 500
                },
                "resumen": {
                  "type": "string",
                  "description": "Summary text of the conversation",
                  "maxLength": 5000
                }
              }
            }
          }
        }
      ]
    },
    "successResponseModel": {
      "type": "object",
      "required": ["message", "record_id", "endpoint", "s3_key"],
      "properties": {
        "message": {
          "type": "string",
          "description": "Human-readable confirmation message"
        },
        "record_id": {
          "type": "string",
          "description": "Unique UUID assigned to the received record"
        },
        "endpoint": {
          "type": "string",
          "description": "Which endpoint processed the request (details or summary)"
        },
        "s3_key": {
          "type": "string",
          "description": "S3 key where the record was landed"
        }
      }
    },
    "errorMessageModel": {
      "type": "object",
      "required": ["error"],
      "properties": {
        "error": {
          "type": "string"
        }
      }
    }
  },
