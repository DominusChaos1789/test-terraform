{
  "info": {
    "name": "Empatia Transcripts API",
    "description": "Collection for testing the Empatia API Gateway endpoints (/details/events and /summary/events). Sends conversation transcripts and summaries, which are queued in SQS and landed in S3.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://ba5xmxdwoh.execute-api.us-east-2.amazonaws.com/dev-1",
      "type": "string"
    },
    {
      "key": "api_key",
      "value": "REPLACE_WITH_YOUR_API_KEY",
      "type": "string"
    }
  ],
  "auth": {
    "type": "apikey",
    "apikey": [
      { "key": "key", "value": "x-api-key", "type": "string" },
      { "key": "value", "value": "{{api_key}}", "type": "string" },
      { "key": "in", "value": "header", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "Details",
      "item": [
        {
          "name": "POST Details - Valid",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 202', function () {",
                  "    pm.response.to.have.status(202);",
                  "});",
                  "",
                  "pm.test('Response has record_id', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('record_id');",
                  "    pm.expect(json.endpoint).to.eql('details');",
                  "});",
                  "",
                  "pm.test('Response has s3_key under transcripts/details', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.s3_key).to.include('transcripts/details/');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"tenant_id\": \"empatia\",\n    \"conversacion_id\": \"conv_0001\",\n    \"tipo_documento\": \"CC\",\n    \"numero_documento\": \"1234567890\",\n    \"numero_telefono\": \"3001234567\",\n    \"tipo_producto\": \"credito\",\n    \"tipo\": \"conversacion\",\n    \"fecha_creacion\": \"2026-06-12T10:00:00Z\",\n    \"data\": {\n        \"conversacion\": \"Cliente: Hola, tengo una duda sobre mi factura.\\nAgente: Claro, dime en que te ayudo.\"\n    }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/empatia/details/events",
              "host": ["{{base_url}}"],
              "path": ["empatia", "details", "events"]
            },
            "description": "Sends a valid full conversation transcript. Expects 202 Accepted."
          },
          "response": []
        },
        {
          "name": "POST Details - Missing Field (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 400', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test('Response contains error about missing fields', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('error');",
                  "    pm.expect(json.error).to.include('Missing required fields');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"tenant_id\": \"empatia\",\n    \"tipo\": \"conversacion\",\n    \"data\": {\n        \"conversacion\": \"hola\"\n    }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/empatia/details/events",
              "host": ["{{base_url}}"],
              "path": ["empatia", "details", "events"]
            },
            "description": "Missing conversacion_id, tipo_documento, numero_documento, numero_telefono, tipo_producto, fecha_creacion. Expects 400."
          },
          "response": []
        },
        {
          "name": "POST Details - Wrong tipo value (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 400', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test('Error mentions tipo must be conversacion', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.error).to.include(\"'conversacion'\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"tenant_id\": \"empatia\",\n    \"conversacion_id\": \"conv_0001\",\n    \"tipo_documento\": \"CC\",\n    \"numero_documento\": \"1234567890\",\n    \"numero_telefono\": \"3001234567\",\n    \"tipo_producto\": \"credito\",\n    \"tipo\": \"resumen\",\n    \"fecha_creacion\": \"2026-06-12T10:00:00Z\",\n    \"data\": {\n        \"conversacion\": \"texto de prueba\"\n    }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/empatia/details/events",
              "host": ["{{base_url}}"],
              "path": ["empatia", "details", "events"]
            },
            "description": "Sends tipo='resumen' to the /details endpoint, which expects tipo='conversacion'. Expects 400."
          },
          "response": []
        },
        {
          "name": "POST Details - Invalid JSON (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 400', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test('Error mentions invalid JSON', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.error).to.include('Invalid JSON');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"tenant_id\": \"empatia\",\n    \"conversacion_id\": \"conv_0001\",\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/empatia/details/events",
              "host": ["{{base_url}}"],
              "path": ["empatia", "details", "events"]
            },
            "description": "Malformed JSON (trailing comma). Expects 400 'Invalid JSON in request body.'"
          },
          "response": []
        }
      ]
    },
