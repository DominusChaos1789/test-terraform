    {
      "name": "Auth & Method Errors",
      "item": [
        {
          "name": "POST Details - No API Key (403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 403', function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"tenant_id\": \"empatia\",\n    \"conversacion_id\": \"conv_0001\",\n    \"tipo_documento\": \"CC\",\n    \"numero_documento\": \"1234567890\",\n    \"numero_telefono\": \"3001234567\",\n    \"tipo_producto\": \"credito\",\n    \"tipo\": \"conversacion\",\n    \"fecha_creacion\": \"2026-06-12T10:00:00Z\",\n    \"data\": {\n        \"conversacion\": \"prueba sin api key\"\n    }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/empatia/details/events",
              "host": ["{{base_url}}"],
              "path": ["empatia", "details", "events"]
            },
            "description": "Deliberately overrides auth to 'No Auth' to confirm API Gateway blocks requests without x-api-key. Expects 403 Forbidden (from API Gateway, not the Lambda)."
          },
          "response": []
        },
        {
          "name": "GET Details - Wrong Method",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/empatia/details/events",
              "host": ["{{base_url}}"],
              "path": ["empatia", "details", "events"]
            },
            "description": "GET is not a defined method on this resource. API Gateway will likely return 403 Missing Authentication Token (since no GET method exists) before the Lambda is ever invoked."
          },
          "response": []
        },
        {
          "name": "POST Unknown Endpoint (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 404 or 403', function () {",
                  "    pm.expect([403, 404]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"tenant_id\": \"empatia\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/empatia/wrong/events",
              "host": ["{{base_url}}"],
              "path": ["empatia", "wrong", "events"]
            },
            "description": "Hits a path that doesn't exist as an API Gateway resource. Will likely be blocked by API Gateway itself (403 Missing Authentication Token) rather than reaching the Lambda's own 404 logic, since no resource/method is defined for this path."
          },
          "response": []
        }
      ]
    }
  ]
